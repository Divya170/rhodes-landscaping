# NestJS API
PORT=4000
# SQLite file (relative to backend/). DATABASE_URL=sqlite:../database/app.sqlite also works.
DATABASE_PATH=../database/app.sqlite
CORS_ORIGIN=http://localhost:3000

# Admin sessions (HttpOnly cookie + CSRF token). Change in production!
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=8
# Cookies are Secure automatically when NODE_ENV=production; force with COOKIE_SECURE=true/false
COOKIE_SECURE=

# Seeded on first boot only (when no admin exists)
ADMIN_EMAIL=admin@rhodeslandscaping.local
ADMIN_PASSWORD=RhodesAdmin#2026
ADMIN_NAME=Easton Rhodes

# Estimate requests: limit per IP (Handoff: "rate limiting")
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10

# Admin-uploaded site photos (relative to backend/), public at /uploads
UPLOAD_DIR=uploads
# Inspiration photos attached to estimate requests — PRIVATE, never served publicly.
# Only signed-in admins can view them. Unattached uploads are deleted after 24 h.
PRIVATE_UPLOAD_DIR=private-uploads

# Optional email: notify the owner and acknowledge the customer for each new request.
# Sent after the DB commit; failures are recorded and never drop the request. Empty SMTP_HOST = off.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM="Rhodes Landscaping <no-reply@example.com>"
# Owner recipient; defaults to the business email in Admin → Settings when empty
NOTIFY_TO=
ADMIN_URL=http://localhost:3000/admin
